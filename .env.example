# ── copy to .env and fill in ────────────────────────────────────────────────
# Never commit .env. The server keys below must never appear in frontend code.

PORT=8080

# Long random string. Changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# The account that gets admin rights. Register this email through the normal
# signup form once, and it is promoted automatically on next boot.
ADMIN_EMAIL=you@example.com

# ── pricing ─────────────────────────────────────────────────────────────────
# Midtrans amounts are in whole rupiah, no decimals.
PLAN_PRICE_IDR=99000
PLAN_DAYS=30
PLAN_NAME=TAPE Alerts — 30 days

# ── Midtrans ────────────────────────────────────────────────────────────────
# From dashboard.midtrans.com → Settings → Access Keys.
# Use the sandbox keys and MIDTRANS_PRODUCTION=false until you have tested a
# real payment end to end.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_PRODUCTION=false

# Public base URL of this server, used to build the webhook URL you paste into
# the Midtrans dashboard (Settings → Configuration → Payment Notification URL):
#   https://your-domain.com/api/payments/webhook
PUBLIC_URL=https://your-domain.com

# ── market data ─────────────────────────────────────────────────────────────
# The server holds ONE upstream connection and fans out to all viewers.
BINANCE_WS=wss://stream.binance.com:9443/ws/btcusdt@trade
BINANCE_WS_FALLBACK=wss://data-stream.binance.vision/ws/btcusdt@trade

# Alert ladder, in USD of a single trade. Everything below DOLPHIN is ignored.
TIER_DOLPHIN=10000
TIER_SHARK=50000
TIER_WHALE=100000
TIER_HUMPBACK=500000
